# Backend security
API_AUTH_TOKEN=change_this_long_random_token
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Supabase service role key only on backend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key

# Bitget
BITGET_API_KEY=your_key
BITGET_API_SECRET=your_secret
BITGET_API_PASSPHRASE=your_passphrase
EXCHANGE_SANDBOX=false

# V7 live protection gates. Real orders require all 3:
# settings.live_mode=true + LIVE_TRADING_UNLOCK=true + EXCHANGE_STOPS_VERIFIED=true
LIVE_TRADING_UNLOCK=false
EXCHANGE_STOPS_VERIFIED=false

# Calendar provider
CALENDAR_PROVIDER=fmp
FMP_API_KEY=your_fmp_api_key
TRADING_ECONOMICS_KEY=
TRADING_ECONOMICS_SECRET=
